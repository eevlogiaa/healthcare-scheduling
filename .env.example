# Copy ke .env lalu sesuaiin: cp .env.example .env
# .env udah masuk .gitignore, jangan commit credential asli ya.

# --- PostgreSQL (1 instance, tiap service punya DB sendiri) ---
POSTGRES_USER=postgres
# dipake di connection URL, hindari karakter @ : / ? # %
POSTGRES_PASSWORD=change-me

# --- Auth service ---
# minimal 32 karakter, generate pake: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# umur access token (detik)
JWT_EXPIRES_IN=3600
BCRYPT_SALT_ROUNDS=10

# --- Schedule service ---
# durasi 1 konsultasi (menit), jadwal dokter yang sama gak boleh overlap di rentang ini
SCHEDULE_DURATION_MINUTES=30
# TTL cache Redis (detik), 0 = matiin cache
CACHE_TTL_SECONDS=60
AUTH_CACHE_TTL_SECONDS=60
AUTH_REQUEST_TIMEOUT_MS=5000

# --- dipake auth-service & schedule-service ---
GRAPHQL_PLAYGROUND=true

# --- Notification service (default-nya ngarah ke container Mailpit) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Healthcare Clinic <no-reply@healthcare.local>
APP_TIMEZONE=Asia/Jakarta
QUEUE_CONCURRENCY=5

# --- port UI Mailpit di host (ganti kalo 8025 udah kepake) ---
MAILPIT_UI_HOST_PORT=8025
