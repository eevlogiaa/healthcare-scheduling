# Cuma perlu kalo service ini dijalanin langsung di host (npm run start:dev).
# Copy ke .env. Kalo pake docker compose, nilainya udah diisi dari sana.
PORT=3001
# samain sama POSTGRES_USER / POSTGRES_PASSWORD di .env root
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/auth_db?schema=public
# minimal 32 karakter, generate pake: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=3600
BCRYPT_SALT_ROUNDS=10
GRAPHQL_PLAYGROUND=true
