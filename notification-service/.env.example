# Cuma perlu kalo service ini dijalanin langsung di host (npm run start:dev).
# Copy ke .env. Kalo pake docker compose, nilainya udah diisi dari sana.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Healthcare Clinic <no-reply@healthcare.local>
APP_TIMEZONE=Asia/Jakarta
QUEUE_CONCURRENCY=5
