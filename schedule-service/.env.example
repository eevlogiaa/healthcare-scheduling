# Cuma perlu kalo service ini dijalanin langsung di host (npm run start:dev).
# Copy ke .env. Kalo pake docker compose, nilainya udah diisi dari sana.
PORT=3002
# samain sama POSTGRES_USER / POSTGRES_PASSWORD di .env root
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/schedule_db?schema=public
AUTH_SERVICE_URL=http://localhost:3001
AUTH_REQUEST_TIMEOUT_MS=5000
AUTH_CACHE_TTL_SECONDS=60
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=60
SCHEDULE_DURATION_MINUTES=30
GRAPHQL_PLAYGROUND=true
