                "body": {
                  "mode": "graphql",
                  "graphql": {
                    "query": "mutation CreateCustomer($input: CreateCustomerInput!) {\n  createCustomer(input: $input) {\n    id\n    name\n    email\n  }\n}\n",
                    "variables": "{\n  \"input\": {\n    \"name\": \"Jane Doe\",\n    \"email\": \"jane.doe@example.com\"\n  }\n}"
                  }
                },
                "url": {
                  "raw": "{{scheduleUrl}}/graphql",
                  "host": [
                    "{{scheduleUrl}}"
                  ],
                  "path": [
                    "graphql"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const body = pm.response.json();",
                      "pm.test('no GraphQL errors', () => pm.expect(body.errors, JSON.stringify(body.errors)).to.be.undefined);",
                      "if (body.data) pm.collectionVariables.set('customerId', body.data.createCustomer.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Update customer",
              "request": {
                "method": "POST",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{token}}",
                      "type": "string"
                    }
                  ]
