                    "query": "query Customer($id: ID!) {\n  customer(id: $id) {\n    id\n    name\n    email\n    createdAt\n    updatedAt\n  }\n}\n",
                    "variables": "{\n  \"id\": \"{{customerId}}\"\n}"
