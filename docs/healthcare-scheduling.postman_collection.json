                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "graphql",
                  "graphql": {
                    "query": "mutation UpdateCustomer($id: ID!, $input: UpdateCustomerInput!) {\n  updateCustomer(id: $id, input: $input) {\n    id\n    name\n    email\n    updatedAt\n  }\n}\n",
                    "variables": "{\n  \"id\": \"{{customerId}}\",\n  \"input\": {\n    \"name\": \"Jane A. Doe\"\n  }\n}"
                  }
                },
                "url": {
                  "raw": "{{scheduleUrl}}/graphql",
                  "host": [
                    "{{scheduleUrl}}"
                  ],
                  "path": [
                    "graphql"
