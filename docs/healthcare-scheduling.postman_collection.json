{
  "info": {
    "name": "Healthcare Scheduling System",
    "description": "GraphQL requests for the Auth Service (port 3001) and the Schedule Service (port 3002).\n\nRun \"Register\" and \"Login\" first: Login stores the access token in the `token` collection variable, which every Schedule Service request sends as `Authorization: Bearer <token>`. Create requests store the new IDs in collection variables as well.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "authUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "scheduleUrl",
      "value": "http://localhost:3002"
    },
    {
      "key": "email",
      "value": "admin@clinic.test"
    },
    {
      "key": "password",
      "value": "supersecret1"
    },
    {
      "key": "scheduledAt",
      "value": "2030-01-15T02:00:00.000Z"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "doctorId",
      "value": ""
    },
    {
      "key": "scheduleId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Register($input: RegisterInput!) {\n  register(input: $input) {\n    id\n    email\n    createdAt\n  }\n}\n",
                "variables": "{\n  \"input\": {\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{authUrl}}/graphql",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Login($input: LoginInput!) {\n  login(input: $input) {\n    accessToken\n    tokenType\n    expiresIn\n    user {\n      id\n      email\n    }\n  }\n}\n",
                "variables": "{\n  \"input\": {\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{authUrl}}/graphql",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('no GraphQL errors', () => pm.expect(body.errors, JSON.stringify(body.errors)).to.be.undefined);",
                  "if (body.data) pm.collectionVariables.set('token', body.data.login.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Validate token",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ValidateToken($token: String!) {\n  validateToken(token: $token) {\n    id\n    email\n  }\n}\n",
                "variables": "{\n  \"token\": \"{{token}}\"\n}"
              }
            },
            "url": {
              "raw": "{{authUrl}}/graphql",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Schedule Service",
      "item": [
        {
          "name": "Customers",
          "item": [
            {
              "name": "Create customer",
              "request": {
                "method": "POST",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{token}}",
                      "type": "string"
                    }
