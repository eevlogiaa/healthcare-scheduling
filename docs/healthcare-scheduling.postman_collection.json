                    "query": "query Schedules($filter: ScheduleFilterInput, $page: Int, $limit: Int) {\n  schedules(filter: $filter, page: $page, limit: $limit) {\n    items {\n      id\n      objective\n      scheduledAt\n      customer {\n        name\n      }\n      doctor {\n        name\n      }\n    }\n    pageInfo {\n      total\n      page\n      totalPages\n    }\n  }\n}\n",
                    "variables": "{\n  \"filter\": {\n    \"doctorId\": \"{{doctorId}}\",\n    \"from\": \"2030-01-01T00:00:00.000Z\",\n    \"to\": \"2030-12-31T23:59:59.999Z\"\n  },\n  \"page\": 1,\n  \"limit\": 10\n}"
