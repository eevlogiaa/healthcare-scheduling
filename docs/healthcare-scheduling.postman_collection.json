                "description": "Send it twice to see the CONFLICT error: a doctor cannot have two consultations less than SCHEDULE_DURATION_MINUTES apart."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
