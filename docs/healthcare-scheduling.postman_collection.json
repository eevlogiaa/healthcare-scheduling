                    "query": "query Customers($page: Int, $limit: Int) {\n  customers(page: $page, limit: $limit) {\n    items {\n      id\n      name\n      email\n    }\n    pageInfo {\n      total\n      page\n      limit\n      totalPages\n      hasNextPage\n      hasPreviousPage\n    }\n  }\n}\n",
                    "variables": "{\n  \"page\": 1,\n  \"limit\": 10\n}"
                  }
                },
                "url": {
                  "raw": "{{scheduleUrl}}/graphql",
                  "host": [
                    "{{scheduleUrl}}"
